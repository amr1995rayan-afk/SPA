# GitHub Models API Token
# Gehe zu https://github.com/settings/tokens und erstelle einen Token
# Kopiere diesen Token und füge ihn unten ein
GITHUB_TOKEN=dein_github_token_hier

# ODER: Falls du OpenAI verwenden möchtest, kommentiere GITHUB_TOKEN aus 
# und verwende stattdessen:
# OPENAI_API_KEY=dein_openai_api_key_hier
